{
  "rewrites": [
    {
      "source": "/pitch/assets/:path*",
      "destination": "https://geoland-pitch.vercel.app/assets/:path*"
    },
    {
      "source": "/pitch/logo.svg",
      "destination": "https://geoland-pitch.vercel.app/logo.svg"
    },
    {
      "source": "/pitch/:path*",
      "destination": "https://geoland-pitch.vercel.app/:path*"
    },
    {
      "source": "/pitch",
      "destination": "https://geoland-pitch.vercel.app/"
    }
  ]
}
